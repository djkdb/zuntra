// TripMate data model. See docs/ARCHITECTURE.md §4 for the ERD and delete policies.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum TravelStyle {
  SIGHTSEEING
  FOOD
  RELAXATION
  NATURE
  SHOPPING
  PHOTO
  ACTIVITY
  CULTURE
}

enum TravelPace {
  RELAXED
  MODERATE
  PACKED
}

enum BudgetLevel {
  BUDGET
  STANDARD
  LUXURY
}

enum CompanionType {
  SOLO
  FRIENDS
  PARTNER
  FAMILY
  GROUP
}

enum TripStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TripMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum PlaceCategory {
  SIGHTSEEING
  FOOD
  CAFE
  SHOPPING
  NATURE
  CULTURE
  ACTIVITY
  LODGING
  AIRPORT
  TRANSPORT
  OTHER
}

enum TransportMode {
  WALK
  TRANSIT
  BUS
  TRAIN
  TAXI
  CAR
  BIKE
  FLIGHT
  OTHER
}

enum ItineraryItemStatus {
  PLANNED
  IN_PROGRESS
  DONE
  SKIPPED
}

enum ContentSource {
  USER
  AI
}

enum ExpenseCategory {
  LODGING
  TRANSPORT
  FOOD
  SIGHTSEEING
  SHOPPING
  OTHER
}

enum Mood {
  AMAZING
  HAPPY
  CALM
  TIRED
  SAD
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIActionType {
  ADD_PLACE
  REMOVE_PLACE
  RESCHEDULE
  REPLACE_PLACE
  UPDATE_BUDGET
  CREATE_NOTE
  CREATE_JOURNAL
  SUGGEST_ALTERNATIVE
}

enum AIActionStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  EXPIRED
}

enum AIFeature {
  PLANNER
  RESCHEDULER
  COMPANION
  ANALYZER
  PACKING
  REPORTER
}

// ───────────────────────────── Auth / User ─────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  travelProfile   TravelProfile?
  ownedTrips      Trip[]           @relation("TripOwner")
  memberships     TripMember[]
  expenses        Expense[]
  journalEntries  JournalEntry[]
  photos          TripPhoto[]
  conversations   AIConversation[]
  aiActions       AIAction[]
  aiUsageLogs     AIUsageLog[]
  analyticsEvents AnalyticsEvent[]
}

// Auth.js adapter models (kept for OAuth providers).
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model TravelProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  styles        TravelStyle[]
  pace          TravelPace    @default(MODERATE)
  budgetLevel   BudgetLevel   @default(STANDARD)
  favoriteFoods String[]
  companionType CompanionType @default(SOLO)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Trip ─────────────────────────────

model Trip {
  id              String        @id @default(cuid())
  ownerId         String
  title           String
  destination     String
  timezone        String        @default("Asia/Seoul")
  /// Destination centre, resolved by the maps/weather geocoder (for weather + map).
  destinationLat  Float?
  destinationLng  Float?
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  travelerCount   Int           @default(1)
  styles          TravelStyle[]
  pace            TravelPace?
  preferredPlaces String[]
  preferredFoods  String[]
  purpose         String?
  notes           String?
  currency        String        @default("KRW") @db.Char(3)
  status          TripStatus    @default(ACTIVE)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner          User              @relation("TripOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        TripMember[]
  days           Day[]
  places         Place[]
  budget         Budget?
  expenses       Expense[]
  packingItems   PackingItem[]
  journalEntries JournalEntry[]
  photos         TripPhoto[]
  weather        WeatherSnapshot[]
  conversations  AIConversation[]
  aiActions      AIAction[]
  report         TravelReport?
  aiUsageLogs    AIUsageLog[]

  @@index([ownerId, startDate])
}

model TripMember {
  id        String         @id @default(cuid())
  tripId    String
  userId    String
  role      TripMemberRole @default(VIEWER)
  createdAt DateTime       @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}

model Day {
  id        String   @id @default(cuid())
  tripId    String
  date      DateTime @db.Date
  dayNumber Int
  title     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items          ItineraryItem[]
  expenses       Expense[]
  journalEntries JournalEntry[]

  @@unique([tripId, date])
  @@unique([tripId, dayNumber])
}

model Place {
  id              String        @id @default(cuid())
  tripId          String
  name            String
  category        PlaceCategory @default(OTHER)
  address         String?
  latitude        Float?
  longitude       Float?
  isIndoor        Boolean?
  provider        String?
  providerPlaceId String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items          ItineraryItem[]
  journalEntries JournalEntry[]

  @@index([tripId])
}

model ItineraryItem {
  id                    String              @id @default(cuid())
  dayId                 String
  placeId               String?
  title                 String
  category              PlaceCategory       @default(OTHER)
  position              Int
  /// Minutes after local midnight in the trip timezone (0–1439).
  startMinute           Int
  durationMinutes       Int                 @default(60)
  /// Travel time from the previous item on the same day.
  travelMinutesFromPrev Int?
  transportMode         TransportMode?
  estimatedCost         Decimal?            @db.Decimal(12, 2)
  note                  String?
  status                ItineraryItemStatus @default(PLANNED)
  source                ContentSource       @default(USER)
  completedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  day      Day       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  place    Place?    @relation(fields: [placeId], references: [id], onDelete: SetNull)
  expenses Expense[]

  @@index([dayId, position])
}

// ───────────────────────────── Money ─────────────────────────────

model Budget {
  id          String   @id @default(cuid())
  tripId      String   @unique
  totalAmount Decimal  @db.Decimal(12, 2)
  currency    String   @db.Char(3)
  /// Optional per-category allocation: { [ExpenseCategory]: amount } (validated by Zod).
  allocations Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Expense {
  id              String          @id @default(cuid())
  tripId          String
  dayId           String?
  itineraryItemId String?
  createdById     String?
  title           String
  category        ExpenseCategory
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @db.Char(3)
  note            String?
  spentAt         DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day           Day?           @relation(fields: [dayId], references: [id], onDelete: SetNull)
  itineraryItem ItineraryItem? @relation(fields: [itineraryItemId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tripId, spentAt])
}

// ───────────────────────────── Prepare / Remember ─────────────────────────────

model PackingItem {
  id        String        @id @default(cuid())
  tripId    String
  name      String
  group     String        @default("기본")
  quantity  Int           @default(1)
  isPacked  Boolean       @default(false)
  reason    String?
  source    ContentSource @default(USER)
  position  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}

model JournalEntry {
  id        String   @id @default(cuid())
  tripId    String
  dayId     String?
  placeId   String?
  authorId  String?
  content   String
  mood      Mood?
  rating    Int?
  entryDate DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip   Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day    Day?        @relation(fields: [dayId], references: [id], onDelete: SetNull)
  place  Place?      @relation(fields: [placeId], references: [id], onDelete: SetNull)
  author User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  photos TripPhoto[]

  @@index([tripId, entryDate])
}

model TripPhoto {
  id             String    @id @default(cuid())
  tripId         String
  journalEntryId String?
  uploaderId     String?
  storageKey     String    @unique
  contentType    String    @default("image/webp")
  sizeBytes      Int       @default(0)
  width          Int?
  height         Int?
  caption        String?
  takenAt        DateTime?
  createdAt      DateTime  @default(now())

  trip         Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  uploader     User?         @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([tripId])
}

model WeatherSnapshot {
  id                       String   @id @default(cuid())
  tripId                   String
  date                     DateTime @db.Date
  provider                 String
  condition                String
  tempMinC                 Float
  tempMaxC                 Float
  precipitationProbability Int?
  fetchedAt                DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, date, provider])
}

model TravelReport {
  id          String   @id @default(cuid())
  tripId      String   @unique
  /// Structured report validated by Zod (stats, highlights, AI retrospective).
  content     Json
  generatedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── AI ─────────────────────────────

model AIConversation {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  title     String?
  /// Rolling summary of older messages to keep prompt context small.
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip     Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]
  actions  AIAction[]

  @@index([tripId, userId, updatedAt])
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String
  /// Assistant extras (quick replies, situation flags). Validated by Zod on read.
  meta           Json?
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actions      AIAction[]

  @@index([conversationId, createdAt])
}

model AIAction {
  id             String         @id @default(cuid())
  tripId         String
  userId         String
  conversationId String?
  messageId      String?
  type           AIActionType
  /// Validated against the per-type Zod schema before it is stored and again before it runs.
  payload        Json
  status         AIActionStatus @default(PROPOSED)
  error          String?
  decidedAt      DateTime?
  expiresAt      DateTime?
  executedAt     DateTime?
  createdAt      DateTime       @default(now())

  trip         Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      AIMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([tripId, status])
}

model AIUsageLog {
  id               String    @id @default(cuid())
  userId           String?
  tripId           String?
  feature          AIFeature
  model            String
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  costUsd          Decimal   @default(0) @db.Decimal(10, 6)
  latencyMs        Int
  success          Boolean
  errorCode        String?
  cached           Boolean   @default(false)
  createdAt        DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([feature, createdAt])
}

// ───────────────────────────── Analytics ─────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  userId     String?
  /// Opaque trip id only — never names, destinations or free text.
  tripId     String?
  properties Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
}

/// Photo bytes when STORAGE_PROVIDER=database — lets a Postgres-only deployment (e.g. Neon)
/// keep photos without a separate object store. Photos are resized to ≤2048px WebP client-side.
model StoredObject {
  key         String   @id
  contentType String
  body        Bytes
  createdAt   DateTime @default(now())
}
