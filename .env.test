DATABASE_URL="postgresql://tripmate:tripmate@localhost:5432/tripmate_test?schema=public"
AUTH_SECRET="test-secret-not-for-production-use-0123456789"
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL="http://localhost:3100"
# E2E creates many accounts from one IP.
RATE_LIMIT_SIGNUP_PER_HOUR=1000
RATE_LIMIT_LOGIN_PER_15MIN=1000

# Tests and E2E always use the deterministic AI, weather and maps providers.
AI_PROVIDER=mock
WEATHER_PROVIDER=mock
MAPS_PROVIDER=mock
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage-test
