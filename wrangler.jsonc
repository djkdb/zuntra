{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zuntra",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat: Node APIs used by Prisma's pg driver, Auth.js and node:crypto.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "zuntra" }],
  "observability": { "enabled": true },
  // Non-secret configuration. Secrets (DATABASE_URL, AUTH_SECRET, OPENAI_API_KEY,
  // SUPABASE_SERVICE_ROLE_KEY) are set with `npx wrangler secret put <NAME>`.
  // Deployment-specific values (NEXT_PUBLIC_APP_URL, AUTH_URL, SUPABASE_URL, AI_PROVIDER) are set
  // in the dashboard; keep_vars stops a deploy from wiping them. NEXT_PUBLIC_APP_URL is also
  // inlined at build time, so set it as a build variable too.
  "keep_vars": true,
  "vars": {
    "AUTH_TRUST_HOST": "true",
    "SUPABASE_STORAGE_BUCKET": "trip-photos",
    "STORAGE_PROVIDER": "database",
    "WEATHER_PROVIDER": "open-meteo",
    "MAPS_PROVIDER": "osm"
  }
}
