# ── Database ───────────────────────────────────────────────
# PostgreSQL connection string (Supabase / Neon / local)
DATABASE_URL="postgresql://tripmate:tripmate@localhost:5432/tripmate?schema=public"

# ── Auth.js ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Required behind proxies other than Vercel; Vercel sets this automatically.
# AUTH_TRUST_HOST=true

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI (Phase 3+) — server only, never prefix with NEXT_PUBLIC_ ──
# Leave empty to run with the deterministic mock provider.
OPENAI_API_KEY=""

# ── Weather / Maps (Phase 5) ───────────────────────────────
# WEATHER_PROVIDER="open-meteo"
# NEXT_PUBLIC_MAPBOX_TOKEN=""

# ── Rate limits (optional overrides) ───────────────────────
# RATE_LIMIT_SIGNUP_PER_HOUR=5
# RATE_LIMIT_LOGIN_PER_15MIN=10
# RATE_LIMIT_LOGIN_IP_PER_15MIN=60

# ── Photo storage (Phase 6) ────────────────────────────────
# local (default, development) | supabase (production; objects stay private)
# STORAGE_PROVIDER="database"  # or "supabase" (photos in Postgres vs Supabase Storage)
# STORAGE_PROVIDER="supabase"
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""   # server only
# SUPABASE_STORAGE_BUCKET="trip-photos"
